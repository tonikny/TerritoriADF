# Plantilla del lloc nginx del host.
#
# NO editis `config/site-docker.nginx` a mà: es genera amb
#   npm run nginx:render
# i es **sobreescriu** a partir d'aquest fitxer i del valor `BASE_DOMAIN_URL`
# de `back/.env`. La font de veritat és aquesta plantilla; el domini, una sola
# variable. Així el domini només s'ha de canviar en un lloc.

# 1. Definició de les zones de cache
# Aquestes zones es guarden a /var/cache/nginx/ al host
proxy_cache_path /var/cache/nginx/overpass levels=1:2 keys_zone=overpass_cache:10m max_size=1g inactive=7d use_temp_path=off;
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles_cache:10m max_size=5g inactive=30d use_temp_path=off;

# 2. REDIRECCIÓ DE HTTP A HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;

    # Necessari per a les renovacions de Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 3. BLOC SSL UNIFICAT (Docker Proxy Mode)
server {
    # --- ESCOLTA ---
    # TCP: HTTP/1.1 i HTTP/2. És el fallback obligatori: HTTP/3 no existeix en clar
    # i les xarxes que bloquegen UDP han de poder seguir entrant.
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    # UDP: HTTP/3 (QUIC). Mateix port que el TCP, com recomana nginx.
    # Cal obrir 443/UDP al firewall: si no, el navegador cau a h2 en silenci.
    listen 443 quic reuseport;
    listen [::]:443 quic reuseport;

    server_name __APP_DOMAIN__;

    # Certificats SSL (Gestionats pel Host amb Certbot)
    ssl_certificate /etc/letsencrypt/live/__APP_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # TLS 1.2 (TCP, navegadors antics) i 1.3 (QUIC només fa 1.3) els declara
    # `/etc/letsencrypt/options-ssl-nginx.conf`, que s'inclou damunt. No ho
    # repetim ací: nginx avisa a cada `nginx -t` amb «duplicate value "TLSv1.3"
    # in .../sites-enabled/territoriadf». Si algun dia un servidor portara un
    # options-ssl-nginx.conf antic (sense TLS 1.3), QUIC no arrencaria: mira-ho
    # amb `grep ssl_protocols /etc/letsencrypt/options-ssl-nginx.conf` i, si cal,
    # actualitza `python3-certbot-nginx` (o afig la línia ací i conviu amb l'avís).

    # FRONTEND (Proxy al contenidor Docker)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout per a aplicacions React
        proxy_read_timeout 90;

        # --- PROTOCOL I CAPÇALERES DE SEGURETAT ---
        # Tot açò va ací, dins de `location /`, i no al `server`, per la regla
        # d'herència d'`add_header`: si el nivell actual en declara cap, es
        # descarten TOTS els del nivell superior. Les tessel·les i
        # /api/overpass declaren el seu propi `X-Cache-Status`, així que del
        # `server` no en rebrien cap. I no cal que en rebin: són capçaleres de
        # document, i el document se serveix des d'aquest `location`.

        # Anuncia HTTP/3. El navegador el llegeix d'ací, el desa per a tot
        # l'origen i el recorda 24 h (`ma=86400`); sense aquesta capçalera no
        # prova mai QUIC en aquest domini.
        add_header Alt-Svc 'h3=":443"; ma=86400' always;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # CSP: només recursos propis. Sense 'unsafe-inline' a script-src (el
        # build de Vite no genera cap script inline i la PWA no n'injecta cap:
        # `injectRegister: null`). object-src/form-action/base-uri/frame-ancestors
        # tanquen vectors clàssics d'injecció.
        #
        # Els hosts de tessel·les i de WMS apareixen a img-src I a connect-src a
        # posta, perquè els dos motors de mapa no baixen les imatges igual:
        # MapLibre fa servir fetch (`refreshExpiredTiles` val true per defecte, i
        # llavors `canUseHTMLImageElement` és fals a image_request.ts), així que
        # les seues tessel·les es governen per connect-src; Leaflet, el motor de
        # reserva, les carrega amb <img> i es governa per img-src. Si un host
        # només hi fos en una de les dues directives, aquell motor no pintaria
        # els ràsters. El ràster-dem del terreny també va per fetch, però passa
        # per /tiles/icgc-terrain/ (mateix origen), així que 'self' el cobreix.
        # img-src deixa fora les URL `image=*` d'OSM que no hi siguin: aquestes
        # fotos no es veuen, i el component les amaga.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.openstreetmap.org https://*.opentopomap.org https://*.idee.es https://maps.effis.emergency.copernicus.eu https://api.panoramax.xyz https://panoramax.mapcomplete.org https://geoserveis.icgc.cat; connect-src 'self' https://maps.effis.emergency.copernicus.eu https://geoserveis.icgc.cat; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self';" always;
    }

    # STREAM SSE DE POSICIONS (Proxy al backend, sense buffering)
    # El mapa manté oberta aquesta connexió i rep les posicions quan canvien. Necessita un
    # `location` exacte propi: amb el `proxy_buffering` per defecte, nginx acumula els
    # esdeveniments i el mapa es quedaria quiet. `location =` guanya sempre a
    # `location /api/` (prefix), així que aquest bloc no depèn de l'ordre dels `location`.
    location = /api/tracking/stream {
        proxy_pass http://127.0.0.1:3034/api/tracking/stream;

        # Cap a l'upstream, nginx fa HTTP/1.0 amb `Connection: close` per defecte; un stream
        # vol 1.1 i la capçalera de connexió buida (la manté oberta).
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cada esdeveniment ha d'arribar quan es produeix: sense buffering i sense caché.
        proxy_buffering off;
        proxy_cache off;

        # El backend envia un `ping` cada 25 s i tanca la connexió als 5 min (perquè el client
        # reconecte i es revalidin permisos i ADF). 1 h dóna marge de sobres.
        proxy_read_timeout 1h;
    }

    # API / BACKEND (Proxy al contenidor Docker port 3034)
    location /api/ {
        proxy_pass http://127.0.0.1:3034;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CACHE OVERPASS (Proxy al contenidor Backend amb cache al host)
    location /api/overpass {
        proxy_pass http://127.0.0.1:3034/api/overpass;

        proxy_cache overpass_cache;
        proxy_cache_methods POST;
        proxy_cache_key "$host$request_uri|$request_body";
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

        add_header X-Cache-Status $upstream_cache_status always;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # PROXY TILES AMB CACHE (Gestionat pel host)
    location /tiles/osm/ {
        proxy_pass https://tile.openstreetmap.org/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status always;
        proxy_set_header User-Agent "TerritoriADF/1.0";
    }

    location /tiles/opentopo/ {
        proxy_pass https://tile.opentopomap.org/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location /tiles/ign-raster/ {
        proxy_pass https://tms-mapa-raster.ign.es/1.0.0/mapa-raster/;
        proxy_ssl_server_name on;
        proxy_set_header User-Agent "TerritoriADF/1.0";
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location /tiles/ign-orto/ {
        proxy_pass https://tms-pnoa-ma.idee.es/1.0.0/pnoa-ma/;
        proxy_ssl_server_name on;
        proxy_set_header User-Agent "TerritoriADF/1.0";
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Terrain-RGB de l'ICGC (5 m). El servei només cobreix Catalunya i publica z6-z14.
    location /tiles/icgc-terrain/ {
        proxy_pass https://geoserveis.icgc.cat/servei/catalunya/contextmaps-terreny-5m-rgb/wmts/;
        proxy_ssl_server_name on;
        proxy_set_header Host geoserveis.icgc.cat;
        proxy_set_header User-Agent "TerritoriADF/1.0";
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status always;
    }
}
