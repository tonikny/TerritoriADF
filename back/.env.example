# Variables d'entorn del Backend (back/.env)

# ============================================================
# OBLIGATÒRIES
# ============================================================

# Clau secreta per signar els tokens JWT (mínim 32 caràcters)
# openssl rand -base64 64
JWT_SECRET=la_teva_clau_secreta_molt_llarga_i_segura_aqui

# Clau per xifrar passwords MQTT a la DB (mínim 32 caràcters)
# openssl rand -base64 64
ENCRYPTION_SECRET=la_teva_clau_de_xifrat_molt_llarga_i_segura_aqui

# Port on escoltarà el servidor backend (default: 3033)
PORT=3033

# Si el backend va darrere d'un proxy invers (nginx/Caddy), posa-ho a true perquè
# els límits de login usin la IP real (X-Forwarded-For). No l'activis si està exposat.
#TRUST_PROXY=false

# ============================================================
# MQTT / MOSQUITTO
# ============================================================

# URL del broker MQTT
#MQTT_BROKER_URL=mqtt://localhost:1883

# Admin del Dynamic Security plugin
MQTT_ADMIN_PASSWORD=password_admin_dynsec

# Client backend per Dynamic Security
MQTT_BACKEND_PASSWORD=password_backend_mqtt

# Prefix topic OwnTracks
#MQTT_TOPIC_PREFIX=owntracks/hidrants

# ============================================================
# DOMINI
# ============================================================

# Domini públic de l'aplicació, sense `https://`.
# És l'única font per a nginx (`npm run nginx:render`) i per als certificats
# de Mosquitto. En desenvolupament pot ser `localhost` o la IP LAN.
BASE_DOMAIN_URL=el_teu_domini

# ============================================================
# OTRC (OwnTracks config download) — OPCIONAL
# ============================================================

# Només cal si el broker OwnTracks és en un host diferent de BASE_DOMAIN_URL.
# Si no es defineix, el .otrc usa BASE_DOMAIN_URL.
#OTRC_HOST=el_teu_domini_o_ip
#OTRC_PORT=51823
#OTRC_TLS=true

# ============================================================
# OPCIONALS
# ============================================================

# URL de l'API d'Overpass (default: https://overpass-api.de/api/interpreter)
#OVERPASS_URL=https://overpass-api.de/api/interpreter

# Contacte (correu o URL) que s'envia al User-Agent de les consultes a Overpass.
# La política d'ús d'Overpass demana un contacte vàlid; posa-hi el teu.
#OVERPASS_CONTACT=contacte@example.com

# Nivell de logging de Fastify (default: info)
# Valors: fatal, error, warn, info, debug, trace
#FASTIFY_LOGLEVEL=info

# ============================================================
# TELEGRAM (Opcional - per enviar notificacions)
# ============================================================
# Bot global de l'admin (notificacions del sistema/backups)
#TELEGRAM_BOT_TOKEN=el_teu_bot_token_de_telegram
#TELEGRAM_CHAT_ID=el_teu_chat_id

# URL pública https on Telegram arribi als webhooks per ADF
# (/api/telegram/webhook/:secret). En dev local cal un túnel amb cert vàlid
# (cloudflared/ngrok). En producció la derivem del Host de la petició, no cal.
#WEBHOOK_PUBLIC_URL=https://xxx.trycloudflare.com

# ============================================================
# GRAPHHOPPER (Opcional - per càlcul de rutes)
# ============================================================
#GRAPHHOPPER_API_KEY=la_teva_api_key_de_graphhopper

# ============================================================
# OSM (Opcional - Sincronització push a OpenStreetMap)
# ============================================================
# Token OAuth 2.0 per publicar canvis a l'API d'OSM.
# Registrar l'aplicació a: https://www.openstreetmap.org/oauth2/applications
# Scope necessari: write_api
# El token OAuth 2.0 d'OSM no expira.
#OSM_ACCESS_TOKEN=el_teu_token_oauth2_aqui
#OSM_API_URL=https://api.openstreetmap.org/api/0.6