{
  "name": "territoriadf-backend",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx src/scripts/dbIntegrityCheck.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "dev": "npm run db:migrate && tsx watch src/server.ts",
    "start": "node dist/scripts/migrate.js && node dist/server.js",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "update:boundaries": "tsx src/scripts/updateBoundaries.ts",
    "create:user": "tsx src/scripts/createUser.ts",
    "db:reset": "tsx src/scripts/resetDb.ts",
    "db:reset-hidrants": "tsx src/scripts/cleanHidrants.ts && npm run db:import-osm",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:import-osm": "tsx src/scripts/importOsm.ts",
    "db:export-osm": "tsx src/scripts/exportAllToOsm.ts",
    "mqtt:cleanup": "tsx src/scripts/cleanupMqtt.ts",
    "telegram:selftest": "tsx src/scripts/telegramSelftest.ts",
    "telegram:rewebhook": "tsx src/scripts/reRegisterTelegramWebhooks.ts",
    "telegram:rewebhook:prod": "node dist/scripts/reRegisterTelegramWebhooks.js"
  },
  "dependencies": {
    "@territoriadf/contracts": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "mqtt": "^5.15.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
